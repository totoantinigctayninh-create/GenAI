rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['username', 'password', 'fullName', 'role']) &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
        data.password is string && data.password.size() >= 1 && data.password.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        (data.role == 'teacher' || data.role == 'student');
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['id', 'type', 'topic', 'examSet', 'prompt', 'correctAnswer', 'explanation']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
        (data.type == 'mcq_single' || data.type == 'mcq_multiple' || data.type == 'dropdown' || data.type == 'matching' || data.type == 'ordering') &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 160 &&
        data.examSet is string && data.examSet.size() >= 1 && data.examSet.size() <= 64 &&
        data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000 &&
        data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 2000;
    }

    function isValidExamAttempt(data) {
      return data.keys().hasAll(['id', 'username', 'fullName', 'totalQuestions', 'durationSeconds', 'completedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.username is string && data.username.size() >= 1 && data.username.size() <= 64 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.totalQuestions is number && data.totalQuestions >= 1 &&
        data.durationSeconds is number && data.durationSeconds >= 0 &&
        data.completedAt is string && data.completedAt.size() <= 64;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserAccount(incoming());
      allow delete: if isValidId(userId);
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create, update: if isValidId(questionId) && isValidQuestion(incoming());
      allow delete: if isValidId(questionId);
    }

    match /attempts/{attemptId} {
      allow read: if true;
      allow create, update: if isValidId(attemptId) && isValidExamAttempt(incoming());
      allow delete: if isValidId(attemptId);
    }
  }
}
